---
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  current?: "home" | "work" | "writing" | "books";
}

const { title, description = site.description, current } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const theme = site.theme;
const nav = [
  { href: "/work", label: "Work", key: "work" },
  { href: "/writing", label: "Writing", key: "writing" },
  { href: "/books", label: "Books", key: "books" },
];
---

<!doctype html>
<html lang="en-GB" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="stylesheet" href={`/themes/${theme}.css`} />
  </head>
  <body>
    {
      theme === "adire" && (
        <div class="band" aria-hidden="true">
          <svg width="100%" height="100%">
            <defs>
              <pattern id="adire" width="64" height="64" patternUnits="userSpaceOnUse">
                <rect width="64" height="64" fill="#24317f" />
                <circle cx="16" cy="16" r="9" fill="none" stroke="#c4cbea" stroke-width="2.2" />
                <circle cx="16" cy="16" r="3" fill="#c4cbea" />
                <circle cx="48" cy="48" r="9" fill="none" stroke="#c4cbea" stroke-width="2.2" />
                <circle cx="48" cy="48" r="3" fill="#c4cbea" />
                <path d="M36 10h20M36 16h20M36 22h20" stroke="#c4cbea" stroke-width="1.6" stroke-dasharray="3 3" />
                <path d="M8 42h16M8 48h16M8 54h16" stroke="#c4cbea" stroke-width="1.6" stroke-dasharray="3 3" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#adire)" />
          </svg>
        </div>
      )
    }
    <div class="page">
      <header class="masthead">
        {
          current === "home" ? (
            <h1 class="name">{site.name}</h1>
          ) : (
            <a class="name" href="/">{site.name}</a>
          )
        }
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current === item.key ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="colophon">
        <p>Written in London. <a href="/rss.xml">Subscribe by RSS</a>.</p>
      </footer>
    </div>
  </body>
</html>
