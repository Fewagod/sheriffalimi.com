---
// Home page. The words on this page live in src/data/home.json,
// which you can edit in Pages CMS under "Home page".
import Base from "../layouts/Base.astro";
import home from "../data/home.json";
import work from "../data/work.json";
import { getPosts, formatDate } from "../lib/posts";

const nowWork = home.showWorkInNow ? work.filter((w) => w.when === "Now") : [];
const posts = (await getPosts()).slice(0, 5);
const elsewhere = (home.elsewhere ?? []).filter((x) => x.label && x.url);
---

<Base current="home">
  <section class="intro">
    {home.headline && <p class="lede">{home.headline}</p>}
    {home.intro && <div class="intro-text" set:html={home.intro} />}
  </section>

  {
    (home.now?.length > 0 || nowWork.length > 0) && (
      <section>
        <h2>Now</h2>
        <ul class="plain-list">
          {home.now?.map((item) => <li>{item}</li>)}
          {nowWork.map((w) => (
            <li>
              {w.url ? <a href={w.url}>{w.org}</a> : <strong>{w.org}</strong>}.{" "}
              {w.description.split(". ")[0].replace(/\.$/, "")}.
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section>
        <h2>Recent writing</h2>
        <ul class="entries">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.id}`}>{p.data.title}</a>
              <span class="meta">{formatDate(p.data.date)}</span>
            </li>
          ))}
        </ul>
        <p class="more"><a href="/writing">All writing</a></p>
      </section>
    )
  }

  {
    elsewhere.length > 0 && (
      <section>
        <h2>Elsewhere</h2>
        <ul class="inline-list">
          {elsewhere.map((x) => (
            <li>
              <a href={x.url}>{x.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
